start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"VvNOxKDut9"}],"key":"GVwBCq6J53"},{"type":"heading","depth":2,"position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"我难道不应该支持尽可能老的版本吗？","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"WSCYdLmLOC"}],"identifier":"id","label":"我难道不应该支持尽可能老的版本吗？","html_id":"id-1","implicit":true,"key":"dJ5IMzfJMY"},{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"简短的回答：不应该。","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"M1yRTQZC2B"}],"key":"Qro5KvlTLD"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"如果你将 CMake 的最低版本设置得太低，CMake 会产生警告甚至报错。截至 CMake 4.4，你能设置的最老版本是 3.5，且任何低于 3.10 的设置都会触发警告。虽然用户在紧急情况下可以通过将 ","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"ClHNrf0EdE"},{"type":"inlineCode","value":"CMAKE_POLICY_VERSION_MINIMUM","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"d8rLOaymky"},{"type":"text","value":" 设置为有效版本来绕过这一限制，但你并不希望用户不得不这么做。","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"SXxOXyFJcN"}],"key":"eCPSgMQoyx"},{"type":"paragraph","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"你","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"HgsxYwj917"},{"type":"strong","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"至少","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"NU5SwFQTWY"}],"key":"tDEfSQGvwb"},{"type":"text","value":"应该使用在你的编译器发布之后推出的 CMake 版本，因为它需要知道该版本编译器的标志等信息。而且，由于 CMake 会自动按照你在 CMake 文件中指定的最低要求版本来兼容旧行为，因此即便在系统范围内安装新版本的 CMake 也是相当安全的。你","position":{"start":{"lin