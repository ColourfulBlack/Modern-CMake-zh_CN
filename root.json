"code","lang":"cmake","value":"# 在 ROOT 6.10 和 6.12 中，ROOT 目标缺失了包含目录和编译标志\nset_property(TARGET ROOT::Core PROPERTY\n    INTERFACE_INCLUDE_DIRECTORIES \"${ROOT_INCLUDE_DIRS}\")\n\n# 早期版本的 ROOT 没有在目标上包含所需的编译标志\nadd_library(ROOT::Flags_CXX IMPORTED INTERFACE)\n\n\n# ROOT 6.14 及更早版本的链接器标志中存在空格 bug\nstring(REPLACE \"-L \" \"-L\" ROOT_EXE_LINKER_FLAGS \"${ROOT_EXE_LINKER_FLAGS}\")\n\n# 修复 ROOT_CXX_FLAGS 实际上并不是 CMake 列表的问题\nseparate_arguments(ROOT_CXX_FLAGS)\nset_property(TARGET ROOT::Flags_CXX APPEND PROPERTY\n    INTERFACE_COMPILE_OPTIONS ${ROOT_CXX_FLAGS})\n\n# 添加宏定义\nseparate_arguments(ROOT_DEFINITIONS)\nforeach(_flag ${ROOT_DEFINITIONS})\n    # 移除可能存在的 -D 或 /D 前缀\n    string(REGEX REPLACE [=[^[-//]D]=] \"\" _flag ${_flag})\n    set_property(TARGET ROOT::Flags_CXX APPEND PROPERTY INTERFACE_COMPILE_DEFINITIONS ${_flag})\nendforeach()\n\n# 这同样修复了链接器标志中的一个 bug\nseparate_arguments(ROOT_EXE_LINKER_FLAGS)\nset_property(TARGET ROOT::Flags_CXX APPEND PROPERTY\n    INTERFACE_LINK_LIBRARIES ${ROOT_EXE_LINKER_FLAGS})\n\n# 请确保同时也链接了 ROOT::Flags_CXX！","position":{"start":{"line":129,"column":1},"end":{"line":160,"column":1}},"key":"MN74PMMxv2"}],"key":"I6EO5u27qn"}],"key":"iuUbT9zgHt"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"MPI","url":"/mpi","group":"查找库（或包）"},"next":{"title":"简单的 ROOT 工程","url":"/readme","group":"查找库（或包）"}}},"domain":"http://pre.render"}