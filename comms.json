My/Version.hpp\"\n    VERSION_STRING REGEX ${VERSION_REGEX})\n\n# 仅提取出版本号本身\nstring(REGEX REPLACE ${VERSION_REGEX} \"\\\\1\" VERSION_STRING \"${VERSION_STRING}\")\n\n# 自动获取 PROJECT_VERSION_MAJOR、My_VERSION_MAJOR 等变量\nproject(My LANGUAGES CXX VERSION ${VERSION_STRING})","position":{"start":{"line":38,"column":1},"end":{"line":52,"column":1}},"key":"DJ0VsYmLyE"},{"type":"paragraph","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"children":[{"type":"text","value":"在上面的代码中，","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"Dsm9HKO3cy"},{"type":"inlineCode","value":"file(STRINGS file_name variable_name REGEX regex)","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"TXJWwJxnEx"},{"type":"text","value":" 选取了与正则表达式相匹配的行；随后使用同一个正则表达式提取出圆括号捕获组中的版本号部分，并通过反向引用替换仅输出该捕获组的内容。","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"aUvzfohy0I"}],"key":"ekeCils29E"}],"key":"GEr3l5XtnB"}],"key":"xLlPMbkyBf"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"用 CMake 进行编程","url":"/functions","group":"基础知识"},"next":{"title":"如何组织你的项目","url":"/structure","group":"基础知识"}}},"domain":"http://pre.render"}